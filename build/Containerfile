# XXX: Temporary fix
ARG GUIDELLM_IMAGE_REPOSITORY=ghcr.io/albertoperdomo2/guidellm
ARG GUIDELLM_IMAGE_TAG=v0.7.0-aperdomo
FROM ${GUIDELLM_IMAGE_REPOSITORY}:${GUIDELLM_IMAGE_TAG}

ARG GUIDELLM_VERSION_LABEL=v0.7.0-aperdomo

ARG HELM_VERSION=v3.17.1
ARG HELMFILE_VERSION=v0.171.0
ARG KUSTOMIZE_VERSION=v5.4.3
ARG OPENSHIFT_CLIENT_VERSION=4.19.5

ENV PYTHONUNBUFFERED=1

# XXX: For GuideLLM correct version
ENV GUIDELLM_VERSION=${GUIDELLM_VERSION_LABEL}

USER root

RUN mkdir -p /tmp/.huggingface && chmod -R 777 /tmp/.huggingface

RUN dnf install -y ca-certificates curl git rsync tar gzip \
    && dnf clean all \
    && rm -rf /var/cache/dnf

RUN curl -fsSL "https://get.helm.sh/helm-${HELM_VERSION}-linux-amd64.tar.gz" -o /tmp/helm.tgz \
    && tar -xzf /tmp/helm.tgz -C /tmp \
    && mv /tmp/linux-amd64/helm /usr/local/bin/helm \
    && rm -rf /tmp/helm.tgz /tmp/linux-amd64

RUN curl -fsSL "https://github.com/helmfile/helmfile/releases/download/${HELMFILE_VERSION}/helmfile_${HELMFILE_VERSION#v}_linux_amd64.tar.gz" -o /tmp/helmfile.tgz \
    && tar -xzf /tmp/helmfile.tgz -C /tmp \
    && mv /tmp/helmfile /usr/local/bin/helmfile \
    && chmod +x /usr/local/bin/helmfile \
    && rm -f /tmp/helmfile.tgz

RUN curl -fsSL "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2F${KUSTOMIZE_VERSION}/kustomize_${KUSTOMIZE_VERSION}_linux_amd64.tar.gz" -o /tmp/kustomize.tgz \
    && tar -xzf /tmp/kustomize.tgz -C /tmp \
    && mv /tmp/kustomize /usr/local/bin/kustomize \
    && chmod +x /usr/local/bin/kustomize \
    && rm -f /tmp/kustomize.tgz

RUN curl -fsSL "https://mirror.openshift.com/pub/openshift-v4/clients/ocp/${OPENSHIFT_CLIENT_VERSION}/openshift-client-linux.tar.gz" -o /tmp/openshift-client.tgz \
    && tar -xzf /tmp/openshift-client.tgz -C /tmp \
    && mv /tmp/oc /usr/local/bin/oc \
    && mv /tmp/kubectl /usr/local/bin/kubectl \
    && chmod +x /usr/local/bin/oc /usr/local/bin/kubectl \
    && rm -f /tmp/openshift-client.tgz /tmp/README.md

WORKDIR /opt/benchflow

COPY pyproject.toml .
COPY src/ src/

# AIPerf and Inference Perf require incompatible exact Transformers versions.
# BenchFlow only invokes their CLIs, so keep each tool in its own environment.
RUN python -m venv /opt/benchflow/venvs/aiperf \
    && /opt/benchflow/venvs/aiperf/bin/pip install --no-cache-dir \
        "aiperf @ git+https://github.com/ai-dynamo/aiperf.git@ajc/agentx" \
    && ln -s /opt/benchflow/venvs/aiperf/bin/aiperf /usr/local/bin/aiperf

RUN python -m venv /opt/benchflow/venvs/inference-perf \
    && /opt/benchflow/venvs/inference-perf/bin/pip install --no-cache-dir \
        "inference-perf @ git+https://github.com/kubernetes-sigs/inference-perf.git@f6c714bb479fea4cedf1e088b04d81a4d0e76fa2" \
    && ln -s /opt/benchflow/venvs/inference-perf/bin/inference-perf /usr/local/bin/inference-perf

RUN pip install --no-cache-dir .

LABEL org.opencontainers.image.description="BenchFlow is a Tekton-based LLM inference benchmarking tool for single-cluster and management-target cluster workflows."

ENTRYPOINT ["bflow"]
CMD ["--help"]
